# 复制成 infra/compose/.env 再填。.env 已被 gitignore：真实值不入库（D11）。
#
# 这里没有主机地址。客户端连哪台机器由客户端自己决定
# （CraftArena.exe -- --server=HOST），服务端不需要知道自己叫什么。

# 必填。Godot Linux 引擎 zip 的 SHA512，取自该 Release 的 SHA512-SUMS.txt。
# 留空则 match-host 镜像拒绝构建，不会装一个没核对过的引擎。
GODOT_SHA512=

# 引擎版本必须与 CD-51 §1 锁定的开发机版本一致，否则权威仿真两边不是同一个引擎。
GODOT_VERSION=4.7.2-stable

# 宿主机上对外发布的端口。改这里不用改客户端默认值以外的任何东西，
# 但改了就要用 --control-plane= / --gateway= 明确告诉客户端。
CONTROL_PLANE_PUBLISH=8080
GATEWAY_PUBLISH=8090

# 对局进程端口段。只在 compose 内网使用，不发布到宿主机。
MATCH_HOST_PORT_RANGE_MIN=42000
MATCH_HOST_PORT_RANGE_MAX=42099

CRAFTARENA_VERSION=0.0.0-dev
CONTROL_PLANE_LOG_LEVEL=info
GATEWAY_LOG_LEVEL=info
MATCH_HOST_LOG_LEVEL=info
