{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://craftarena.local/contracts/simulation_bundle.schema.json",
	"title": "SimulationBundle",
	"description": "v1 TRAPRUSH topology compile of AuthoringWorld. Field list owner: CD-42 §3.4. Pads, two_way/one_way portals, at most one finish occupancy bag, and destructible occupancy bags. Dangling portals are omitted. Not a signed binary, not a Rule VM graph.",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema_version",
		"cell",
		"source_revision",
		"pads",
		"portals",
		"finish",
		"destructibles"
	],
	"properties": {
		"schema_version": { "type": "integer", "const": 1 },
		"cell": { "type": "integer", "minimum": 1 },
		"source_revision": { "type": "integer", "minimum": 0 },
		"pads": {
			"type": "array",
			"items": { "$ref": "#/$defs/pad" }
		},
		"portals": {
			"type": "array",
			"items": { "$ref": "#/$defs/portal" }
		},
		"finish": {
			"type": "array",
			"maxItems": 1,
			"items": { "$ref": "#/$defs/finish" }
		},
		"destructibles": {
			"type": "array",
			"items": { "$ref": "#/$defs/destructible" }
		}
	},
	"$defs": {
		"pad": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"entity_id",
				"x",
				"y",
				"z",
				"order",
				"respawn_dx",
				"respawn_dy",
				"respawn_dz"
			],
			"properties": {
				"entity_id": { "type": "integer", "minimum": 1 },
				"x": { "type": "integer" },
				"y": { "type": "integer" },
				"z": { "type": "integer" },
				"order": { "type": "integer", "minimum": 0 },
				"respawn_dx": { "type": "integer" },
				"respawn_dy": { "type": "integer" },
				"respawn_dz": { "type": "integer" }
			}
		},
		"finish": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"entity_id",
				"x",
				"y",
				"z"
			],
			"properties": {
				"entity_id": { "type": "integer", "minimum": 1 },
				"x": { "type": "integer" },
				"y": { "type": "integer" },
				"z": { "type": "integer" }
			}
		},
		"destructible": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"entity_id",
				"x",
				"y",
				"z",
				"durability"
			],
			"properties": {
				"entity_id": { "type": "integer", "minimum": 1 },
				"x": { "type": "integer" },
				"y": { "type": "integer" },
				"z": { "type": "integer" },
				"durability": { "type": "integer", "minimum": 0 }
			}
		},
		"portal": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"entity_id",
				"target_id",
				"kind",
				"x",
				"y",
				"z",
				"dest_x",
				"dest_y",
				"dest_z",
				"dest_yaw_bam"
			],
			"properties": {
				"entity_id": { "type": "integer", "minimum": 1 },
				"target_id": { "type": "integer", "minimum": 1 },
				"kind": { "type": "string", "enum": ["two_way", "one_way"] },
				"x": { "type": "integer" },
				"y": { "type": "integer" },
				"z": { "type": "integer" },
				"dest_x": { "type": "integer" },
				"dest_y": { "type": "integer" },
				"dest_z": { "type": "integer" },
				"dest_yaw_bam": { "type": "integer" }
			}
		}
	}
}
