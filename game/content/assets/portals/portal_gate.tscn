[gd_scene format=3]

; 传送门占位模型（可玩性深化 轨 2：传送门模型与课内动效）。
;
; **仍是占位美术，不是定稿模型。** 它是程序化网格而不是 `.glb`：传送门是
; 官方课里唯一还没有生成资产的一类占用，而本刀要解决的是「一眼认不出这是门」，
; 不是「补齐美术」。新增第三方资产要走许可证归档与预算门禁（CD-51 §5.1 /
; CD-11 §8.1），那是 M-Art 剩余项，不在这一刀里自选。
;
; 比上一版（单个 TorusMesh 圆环）多的三件事，每件都对应一个读不出来的东西：
;
; * `Base` 底座——圆环悬在半空时读不出「它站在这一格上」；
; * `Core` 门芯——空心圆环从侧面看几乎消失，穿过去时没有「进入」的界面；
; * `Swirl` 三片旋翼——静止的门和静止的装饰物长得一样。它由
;   `MatchCourseMapFx` 按权威 tick 转，所以是确定性的，不读墙钟。
;
; 名字是契约：`MatchCourseMapFx.SWIRL_NAME` 按名字找 `Swirl`。改名要同改那边。

[sub_resource type="TorusMesh" id="TorusMesh_frame"]
inner_radius = 0.3
outer_radius = 0.42
rings = 12
ring_segments = 20

[sub_resource type="StandardMaterial3D" id="Material_frame"]
albedo_color = Color(0.16, 0.62, 0.8, 1)
metallic = 0.4
roughness = 0.35

